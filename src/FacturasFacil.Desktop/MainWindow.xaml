<Window x:Class="FacturasFacil.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FacturasFacil.Desktop"
        xmlns:vm="clr-namespace:FacturasFacil.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="FacturasFacil — Procesador CFDI"
        Height="640" Width="800"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush"      Color="#1E5C9E"/>
        <SolidColorBrush x:Key="BlueLightBrush" Color="#2d7dd2"/>
        <SolidColorBrush x:Key="BluePaleBrush"  Color="#E8F0FB"/>
        <SolidColorBrush x:Key="GreenBrush"     Color="#16a34a"/>
        <SolidColorBrush x:Key="GreenPaleBrush" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Gray50Brush"    Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Gray100Brush"   Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Gray200Brush"   Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Gray600Brush"   Color="#475569"/>
        <SolidColorBrush x:Key="Gray800Brush"   Color="#1E293B"/>

        <local:LogTipoToColorConverter x:Key="LogColor"/>
        <BooleanToVisibilityConverter  x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Gray200Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity=".08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BlueBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BlueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BluePaleBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDEAF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="BorderBrush"      Value="{StaticResource Gray200Brush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Background"       Value="{StaticResource Gray50Brush}"/>
            <Setter Property="Foreground"       Value="{StaticResource Gray800Brush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BlueBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="FacturasFacil" FontSize="18" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  |  Procesador de Facturas CFDI" FontSize="12"
                           Foreground="#FFFFFFAA" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Gray100Brush}"
                BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding Estado}" FontSize="11" Foreground="{StaticResource Gray600Brush}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Carpeta origen -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Carpeta de Facturas (ZIP / RAR)"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource Gray800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Carpeta que contiene los archivos comprimidos con XMLs CFDI."
                                   FontSize="11" Foreground="{StaticResource Gray600Brush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CarpetaOrigen, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" Margin="0,0,8,0" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Examinar…"
                                    Style="{StaticResource SecondaryBtn}"
                                    Command="{Binding SeleccionarOrigenCmd}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Carpeta destino -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Carpeta de Destino del Excel"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource Gray800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="El archivo .xlsx se guardará en esta carpeta."
                                   FontSize="11" Foreground="{StaticResource Gray600Brush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CarpetaDestino, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" Margin="0,0,8,0" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Examinar…"
                                    Style="{StaticResource SecondaryBtn}"
                                    Command="{Binding SeleccionarDestinoCmd}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Acción -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="⚙  Procesar y Generar Excel"
                                    Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding ProcesarCmd}"
                                    Margin="0,0,10,0"/>
                            <Button Content="📂 Abrir carpeta destino"
                                    Style="{StaticResource SecondaryBtn}"
                                    Command="{Binding AbrirCarpetaDestinoCmd}"/>
                        </StackPanel>

                        <!-- Procesando -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                    Visibility="{Binding Procesando, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                         Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Procesando archivos…" FontSize="12"
                                       Foreground="{StaticResource Gray600Brush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Éxito -->
                        <Border CornerRadius="7" Background="{StaticResource GreenPaleBrush}"
                                Padding="12,10" Margin="0,12,0,0"
                                Visibility="{Binding Exitoso, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource GreenBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="✔  Excel generado: "/>
                                    <Run Text="{Binding RutaExcelGenerado}"/>
                                </TextBlock>
                                <Button Content="Abrir Excel"
                                        Style="{StaticResource SecondaryBtn}"
                                        Command="{Binding AbrirExcelCmd}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Log -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Registro de actividad"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource Gray600Brush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource Gray50Brush}"
                                BorderBrush="{StaticResource Gray200Brush}"
                                BorderThickness="1" CornerRadius="6"
                                Height="150" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" FontFamily="Consolas" Padding="0,1"
                                                       Foreground="{Binding Tipo, Converter={StaticResource LogColor}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="[{0:HH:mm:ss}] {1}">
                                                        <Binding Path="Hora"/>
                                                        <Binding Path="Mensaje"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
